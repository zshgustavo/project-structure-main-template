# Application
APP_ENV=development
APP_NAME=project-structure-main-template
APP_PORT=3000
API_PORT=4000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/project_structure_main_template
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# External services
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Observability
LOG_LEVEL=debug
SENTRY_DSN=

# Feature flags
FEATURE_NEW_DASHBOARD=false