# Application
APP_ENV=development
APP_NAME=project-structure-main-template
APP_PORT=3000
API_PORT=4000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/project_structure_main_template
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# External services
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Observability
LOG_LEVEL=debug
SENTRY_DSN=

# Feature flags
FEATURE_NEW_DASHBOARD=false

# ── AI / LLM providers ────────────────────────────────────────────────────────

# Google Cloud / Vertex AI (primary)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_AI_LOCATION=us-central1

# Google Gemini API (direct — alternative to Vertex)
GOOGLE_API_KEY=

# OpenAI / GPT
OPENAI_API_KEY=

# Anthropic / Claude
ANTHROPIC_API_KEY=

# xAI / Grok
XAI_API_KEY=

# Model routing overrides (LiteLLM strings — see config/ai/models.json)
LLM_DEFAULT=vertex_ai/gemini-2.0-flash
LLM_ORCHESTRATOR=vertex_ai/gemini-2.0-flash
LLM_RESEARCHER=anthropic/claude-sonnet-4-20250514
LLM_WRITER=openai/gpt-4o

# Manus IM (external agent — configure per config/integrations/manus.md)
MANUS_API_KEY=