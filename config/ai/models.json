{
  "providers": {
    "vertex_ai": {
      "description": "Google Cloud Vertex AI (primary — GCP native)",
      "env": ["GOOGLE_CLOUD_PROJECT", "GOOGLE_APPLICATION_CREDENTIALS", "VERTEX_AI_LOCATION"],
      "crewai_prefix": "vertex_ai",
      "models": {
        "default": "vertex_ai/gemini-2.0-flash",
        "pro": "vertex_ai/gemini-2.5-pro-preview-05-06",
        "fast": "vertex_ai/gemini-2.0-flash-lite"
      }
    },
    "gemini": {
      "description": "Google AI Studio / Gemini API (direct)",
      "env": ["GOOGLE_API_KEY"],
      "crewai_prefix": "gemini",
      "models": {
        "default": "gemini/gemini-2.0-flash",
        "pro": "gemini/gemini-2.5-pro-preview-05-06"
      }
    },
    "openai": {
      "description": "OpenAI GPT models",
      "env": ["OPENAI_API_KEY"],
      "crewai_prefix": "openai",
      "models": {
        "default": "openai/gpt-4o",
        "mini": "openai/gpt-4o-mini",
        "reasoning": "openai/o3-mini"
      }
    },
    "anthropic": {
      "description": "Anthropic Claude models",
      "env": ["ANTHROPIC_API_KEY"],
      "crewai_prefix": "anthropic",
      "models": {
        "default": "anthropic/claude-sonnet-4-20250514",
        "fast": "anthropic/claude-3-5-haiku-20241022"
      }
    },
    "grok": {
      "description": "xAI Grok (via LiteLLM when configured)",
      "env": ["XAI_API_KEY"],
      "crewai_prefix": "xai",
      "models": {
        "default": "xai/grok-2-latest"
      }
    }
  },
  "defaults": {
    "temperature": 0.3,
    "max_tokens": 4096
  }
}